{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoperatoreconomy.com/design-system/boundary-ledger/semantic-core.schema.json",
  "title": "Boundary Ledger semantic core",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "system", "version", "roles", "operations", "invariants"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "system": { "const": "Boundary Ledger" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "roles": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning", "useWhen", "neverMeans"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(?:[A-Z][a-z]+)*$" },
          "meaning": { "type": "string", "minLength": 12 },
          "useWhen": { "type": "string", "minLength": 12 },
          "neverMeans": { "type": "string", "minLength": 8 }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning", "requiredStateChange"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "meaning": { "type": "string", "minLength": 8 },
          "requiredStateChange": { "type": "string", "minLength": 12 }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule"],
        "properties": {
          "id": { "type": "string", "pattern": "^U-[0-9]{2}$" },
          "rule": { "type": "string", "minLength": 12 }
        }
      }
    }
  }
}
