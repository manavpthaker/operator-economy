{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoperatoreconomy.com/design-system/boundary-ledger/bindings/expression-binding.schema.json",
  "title": "Boundary Ledger expression binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "systemVersion", "medium", "status", "semanticCore", "roles", "prohibitions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "systemVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "medium": { "enum": ["color", "motion", "sound"] },
    "status": { "enum": ["canonical", "provisional", "verified-reference"] },
    "semanticCore": { "type": "string" },
    "roles": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expression", "rules"],
        "properties": {
          "expression": { "type": ["string", "array"] },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          }
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 8 }
    }
  }
}
