  "captions": [
    { "start": 0, "end": 2.6, "text": "Now go back to the guest from the opening." },
    { "start": 2.7, "end": 6.04, "text": "The first stay came through an OTA." },
    { "start": 6.133, "end": 10.52, "text": "After checkout, the hotel earns permission to stay in touch," },
    { "start": 10.584, "end": 13.24, "text": "remembers what mattered about the visit," },
    { "start": 13.28, "end": 16.2, "text": "and gives the guest a reason to come back." },
    { "start": 16.34, "end": 19.68, "text": "The next booking takes the direct path." },
    { "start": 20.265, "end": 24.4, "text": "The win isn't getting rid of the platform that made the introduction." },
    { "start": 24.909, "end": 27.46, "text": "It's making sure the hotel doesn't have to" },
    { "start": 27.46, "end": 29.96, "text": "buy that same introduction forever." }
  ],
