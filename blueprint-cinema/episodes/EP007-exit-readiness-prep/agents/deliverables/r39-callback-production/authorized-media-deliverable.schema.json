{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oe:r39-authorized-media-deliverable",
  "title": "Blueprint Cinema agent deliverable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "workflow_version",
    "work_order_id",
    "episode_folder",
    "input_hashes_used",
    "files_produced",
    "checks",
    "sources_and_provenance",
    "assumptions",
    "unresolved_questions",
    "external_writes",
    "paid_services",
    "synthetic_generation",
    "approval_claimed",
    "production_state_changed",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "workflow_version": {
      "const": "blueprint-cinema-1.0"
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 6
    },
    "episode_folder": {
      "type": "string",
      "pattern": "^EP[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "input_hashes_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "files_produced": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "sources_and_provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "external_writes": {
      "const": true
    },
    "paid_services": {
      "const": true
    },
    "synthetic_generation": {
      "const": true
    },
    "approval_claimed": {
      "const": false
    },
    "production_state_changed": {
      "const": false
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 5
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "outcome"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 3
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        }
      }
    }
  }
}
