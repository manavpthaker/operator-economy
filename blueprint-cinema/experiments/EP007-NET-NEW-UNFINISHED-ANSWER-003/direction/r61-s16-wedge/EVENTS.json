    "data": {
      "insight": "In inline SVG a CSS class fill overrides a fill presentation attribute, so accent labels silently render in the base colour. Use style fills or a dedicated class, and check accents in rendered stills.",
      "applies_when": "Any HyperFrames SVG label that needs a colour different from its class.",
      "avoid_when": "Colour comes only from the class.",
      "confidence": "supported",
      "status": "candidate"
    },
