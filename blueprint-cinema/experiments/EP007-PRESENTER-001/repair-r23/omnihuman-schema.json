              "properties": {
                "turbo_mode": {
                  "title": "Turbo Mode",
                  "description": "Generate a video at a faster rate with a slight quality trade-off.",
                  "default": false,
                  "type": "boolean"
                },
                "resolution": {
                  "title": "Resolution",
                  "enum": [
                    "720p",
                    "1080p"
