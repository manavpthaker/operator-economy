                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/InfinitalkInput"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "The request status.",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/QueueStatus"
                      }
                    }
                  }
                }
              }
            }
          },
          "/fal-ai/infinitalk/requests/{request_id}": {
            "get": {
              "parameters": [
