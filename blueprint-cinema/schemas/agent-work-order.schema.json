{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoperatoreconomy.com/schemas/blueprint-cinema/agent-work-order.schema.json",
  "title": "Blueprint Cinema agent work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "workflow_version", "work_order_id", "episode_folder", "role", "objective",
    "required_gate", "inputs", "owned_output_paths", "forbidden_paths", "dependencies", "acceptance_checks",
    "permissions", "retry_limit", "stopping_conditions", "status"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "workflow_version": {"const": "blueprint-cinema-1.0"},
    "work_order_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 6},
    "episode_folder": {"type": "string", "pattern": "^EP[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "role": {"enum": ["engine_critic", "transcript_mapper", "evidence_mapper", "world_integrity_reviewer", "renderer_implementer", "qa_reviewer"]},
    "objective": {"type": "string", "minLength": 30},
    "required_gate": {"enum": ["inputs_locked", "episode_engine_approved", "world_approved", "visual_plan_approved", "greybox_ready"]},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "owned_output_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "forbidden_paths": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "ticket_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "time_range": {
      "type": "object", "additionalProperties": false, "required": ["in", "out"],
      "properties": {"in": {"type": "number", "minimum": 0}, "out": {"type": "number", "exclusiveMinimum": 0}}
    },
    "acceptance_checks": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["external_writes", "paid_services", "synthetic_generation", "canonical_state_changes"],
      "properties": {
        "external_writes": {"const": false}, "paid_services": {"const": false},
        "synthetic_generation": {"const": false}, "canonical_state_changes": {"const": false}
      }
    },
    "retry_limit": {"type": "integer", "minimum": 0, "maximum": 3},
    "stopping_conditions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "status": {"enum": ["issued", "closed", "cancelled"]}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 5}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }
  }
}
