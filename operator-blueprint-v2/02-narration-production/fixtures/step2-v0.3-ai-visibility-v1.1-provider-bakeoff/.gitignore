# Provider source samples, clone inputs, and generated media never enter Git.
samples/
provider-samples/
clone-inputs/
uploads/
outputs/
audio/
local-media/

# The blind identity map may contain provider/source identity.
blind/
blind-map/
reviews/blind-map.*

# Catch media even when it is placed outside the expected trees.
*.pcm
*.wav
*.wave
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aif
*.aiff
*.caf
*.webm
*.mp4
*.mov

