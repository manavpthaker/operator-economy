{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatoreconomy.com/schemas/provider-action-authorization.schema.json",
  "title": "Single-scope provider action authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "status",
    "approved",
    "scope",
    "target",
    "provider",
    "action",
    "bindings",
    "authorized_limits",
    "consumption",
    "approved_by",
    "approved_at",
    "expires_at",
    "execution_ready",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "oe-provider-action-authorization-v1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active"]},
    "approved": {"type": "boolean"},
    "scope": {
      "enum": [
        "elevenlabs_sample_retrieval",
        "elevenlabs_sample_metadata_inventory",
        "elevenlabs_named_sample_batch_retrieval",
        "hume_clone_creation",
        "elevenlabs_calibration",
        "hume_calibration"
      ]
    },
    "target": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {"kind": {"enum": ["fixture", "episode"]}, "id": {"type": "string", "minLength": 1}}
    },
    "provider": {"enum": ["elevenlabs", "hume"]},
    "action": {"type": "object"},
    "purpose": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance_envelope_sha256",
        "provider_adapter_sha256",
        "provider_bakeoff_plan_sha256",
        "compiled_dry_run_sha256"
      ],
      "properties": {
        "performance_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "provider_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "provider_bakeoff_plan_sha256": {"$ref": "#/$defs/sha256"},
        "compiled_dry_run_sha256": {"$ref": "#/$defs/sha256"},
        "script_sha256": {"$ref": "#/$defs/sha256"},
        "spoken_text_sha256": {"$ref": "#/$defs/sha256"},
        "clone_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"const": "pending"}]},
        "clone_receipt_path": {"type": "string", "minLength": 1},
        "compiled_hash_state": {"type": "string", "minLength": 1}
      }
    },
    "account_requirements": {"$ref": "#/$defs/accountRequirements"},
    "requested_limits": {"$ref": "#/$defs/requestedLimits"},
    "authorized_limits": {"$ref": "#/$defs/authorizedLimits"},
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record_path"],
      "properties": {
        "status": {"enum": ["not_authorized", "unconsumed"]},
        "record_path": {"type": "string"},
        "calls_used": {"type": "integer", "minimum": 0},
        "downloads_used": {"type": "integer", "minimum": 0},
        "uploads_used": {"type": "integer", "minimum": 0},
        "clones_created": {"type": "integer", "minimum": 0},
        "characters_used": {"type": "integer", "minimum": 0},
        "outputs_received": {"type": "integer", "minimum": 0},
        "spend_used_usd": {"type": "number", "minimum": 0}
      }
    },
    "approved_by": {"type": "string"},
    "approved_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "execution_ready": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "draft"}}},
      "then": {
        "properties": {
          "approved": {"const": false},
          "execution_ready": {"const": false},
          "consumption": {"properties": {"status": {"const": "not_authorized"}}},
          "blockers": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "approved": {"const": true},
          "execution_ready": {"const": true},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "minLength": 1},
          "consumption": {"properties": {"status": {"const": "unconsumed"}}},
          "blockers": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "elevenlabs_sample_retrieval"}}},
      "then": {
        "properties": {
          "provider": {"const": "elevenlabs"},
          "action": {"$ref": "#/$defs/retrievalAction"},
          "bindings": {
            "not": {"anyOf": [
              {"required": ["script_sha256"]},
              {"required": ["spoken_text_sha256"]},
              {"required": ["compiled_hash_state"]},
              {"required": ["clone_receipt_sha256"]},
              {"required": ["clone_receipt_path"]}
            ]}
          },
          "requested_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]},
              {"required": ["max_calls"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]},
              {"required": ["primary_lossless_calls"]},
              {"required": ["primary_lossless_characters"]},
              {"required": ["primary_lossless_outputs"]},
              {"required": ["primary_modeled_public_rate_cost_usd"]}
            ]}
          },
          "authorized_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]}
            ]}
          },
          "consumption": {
            "not": {"anyOf": [
              {"required": ["uploads_used"]},
              {"required": ["clones_created"]},
              {"required": ["characters_used"]},
              {"required": ["outputs_received"]}
            ]}
          }
        },
        "not": {"required": ["account_requirements"]}
      }
    },
    {
      "if": {"properties": {"scope": {"const": "elevenlabs_sample_metadata_inventory"}}},
      "then": {
        "required": ["requested_limits"],
        "properties": {
          "provider": {"const": "elevenlabs"},
          "action": {"$ref": "#/$defs/metadataInventoryAction"},
          "bindings": {
            "not": {"anyOf": [
              {"required": ["script_sha256"]},
              {"required": ["spoken_text_sha256"]},
              {"required": ["compiled_hash_state"]},
              {"required": ["clone_receipt_sha256"]},
              {"required": ["clone_receipt_path"]}
            ]}
          },
          "requested_limits": {
            "not": {"anyOf": [
              {"required": ["max_download_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]},
              {"required": ["max_calls"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]},
              {"required": ["primary_lossless_calls"]},
              {"required": ["primary_lossless_characters"]},
              {"required": ["primary_lossless_outputs"]},
              {"required": ["primary_modeled_public_rate_cost_usd"]}
            ]}
          },
          "authorized_limits": {
            "not": {"anyOf": [
              {"required": ["max_download_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]}
            ]}
          },
          "consumption": {
            "not": {"anyOf": [
              {"required": ["uploads_used"]},
              {"required": ["clones_created"]},
              {"required": ["characters_used"]},
              {"required": ["outputs_received"]}
            ]}
          }
        },
        "not": {"required": ["account_requirements"]}
      }
    },
    {
      "if": {"properties": {"scope": {"const": "elevenlabs_named_sample_batch_retrieval"}}},
      "then": {
        "required": ["requested_limits"],
        "properties": {
          "provider": {"const": "elevenlabs"},
          "action": {"$ref": "#/$defs/namedSampleBatchRetrievalAction"},
          "bindings": {
            "not": {"anyOf": [
              {"required": ["script_sha256"]},
              {"required": ["spoken_text_sha256"]},
              {"required": ["compiled_hash_state"]},
              {"required": ["clone_receipt_sha256"]},
              {"required": ["clone_receipt_path"]}
            ]}
          },
          "requested_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]},
              {"required": ["max_calls"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]},
              {"required": ["primary_lossless_calls"]},
              {"required": ["primary_lossless_characters"]},
              {"required": ["primary_lossless_outputs"]},
              {"required": ["primary_modeled_public_rate_cost_usd"]}
            ]}
          },
          "authorized_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]}
            ]}
          },
          "consumption": {
            "not": {"anyOf": [
              {"required": ["uploads_used"]},
              {"required": ["clones_created"]},
              {"required": ["characters_used"]},
              {"required": ["outputs_received"]}
            ]}
          }
        },
        "not": {"required": ["account_requirements"]}
      }
    },
    {
      "if": {"properties": {"scope": {"const": "hume_clone_creation"}}},
      "then": {
        "required": ["account_requirements"],
        "properties": {
          "provider": {"const": "hume"},
          "action": {"$ref": "#/$defs/cloneAction"},
          "bindings": {
            "not": {"anyOf": [
              {"required": ["script_sha256"]},
              {"required": ["spoken_text_sha256"]},
              {"required": ["compiled_hash_state"]},
              {"required": ["clone_receipt_sha256"]},
              {"required": ["clone_receipt_path"]}
            ]}
          },
          "requested_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_calls"]},
              {"required": ["max_sample_download_calls"]},
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_download_bytes"]},
              {"required": ["max_calls"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]},
              {"required": ["primary_lossless_calls"]},
              {"required": ["primary_lossless_characters"]},
              {"required": ["primary_lossless_outputs"]},
              {"required": ["primary_modeled_public_rate_cost_usd"]}
            ]}
          },
          "authorized_limits": {
            "not": {"anyOf": [
              {"required": ["max_calls"]},
              {"required": ["max_downloads"]},
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_download_bytes"]},
              {"required": ["max_characters"]},
              {"required": ["max_outputs"]}
            ]}
          },
          "consumption": {
            "not": {"anyOf": [
              {"required": ["calls_used"]},
              {"required": ["downloads_used"]},
              {"required": ["characters_used"]},
              {"required": ["outputs_received"]}
            ]}
          }
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "elevenlabs_calibration"}}},
      "then": {
        "properties": {
          "provider": {"const": "elevenlabs"},
          "action": {"$ref": "#/$defs/elevenCalibrationAction"},
          "bindings": {
            "not": {"anyOf": [
              {"required": ["compiled_hash_state"]},
              {"required": ["clone_receipt_sha256"]},
              {"required": ["clone_receipt_path"]}
            ]}
          },
          "requested_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_calls"]},
              {"required": ["max_sample_download_calls"]},
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_download_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]}
            ]}
          },
          "authorized_limits": {
            "not": {"anyOf": [
              {"required": ["max_downloads"]},
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_download_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]}
            ]}
          },
          "consumption": {
            "not": {"anyOf": [
              {"required": ["downloads_used"]},
              {"required": ["uploads_used"]},
              {"required": ["clones_created"]}
            ]}
          }
        },
        "not": {"required": ["account_requirements"]}
      }
    },
    {
      "if": {"properties": {"scope": {"const": "hume_calibration"}}},
      "then": {
        "required": ["account_requirements"],
        "properties": {
          "provider": {"const": "hume"},
          "action": {"$ref": "#/$defs/humeCalibrationAction"},
          "requested_limits": {
            "not": {"anyOf": [
              {"required": ["max_metadata_calls"]},
              {"required": ["max_sample_download_calls"]},
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_download_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]}
            ]}
          },
          "authorized_limits": {
            "not": {"anyOf": [
              {"required": ["max_downloads"]},
              {"required": ["max_metadata_response_bytes"]},
              {"required": ["max_download_bytes"]},
              {"required": ["max_ui_uploads"]},
              {"required": ["max_voice_clones"]}
            ]}
          },
          "consumption": {
            "not": {"anyOf": [
              {"required": ["downloads_used"]},
              {"required": ["uploads_used"]},
              {"required": ["clones_created"]}
            ]}
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"status": {"const": "active"}}},
          {"properties": {"scope": {"const": "elevenlabs_sample_retrieval"}}},
          {
            "properties": {
              "action": {
                "required": ["kind"],
                "properties": {
                  "kind": {"const": "read_only_voice_metadata_and_named_sample_retrieval"}
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "action": {
            "required": [
              "metadata_receipt_destination",
              "selected_sample_receipt_destination",
              "rights_and_consent"
            ],
            "properties": {
              "destinations": {"type": "array", "minItems": 1, "maxItems": 1},
              "rights_and_consent": {
                "properties": {"provider_disclosure_approved": {"const": true}}
              }
            }
          },
          "authorized_limits": {
            "required": ["max_calls", "max_downloads", "max_download_bytes", "max_spend_usd"]
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"status": {"const": "active"}}},
          {"properties": {"scope": {"const": "elevenlabs_named_sample_batch_retrieval"}}},
          {
            "properties": {
              "action": {
                "required": ["kind"],
                "properties": {"kind": {"const": "read_only_named_sample_batch_retrieval"}}
              }
            }
          }
        ]
      },
      "then": {
        "required": ["requested_limits"],
        "properties": {
          "action": {
            "required": [
              "source_inventory_receipt_path",
              "source_inventory_receipt_sha256",
              "samples",
              "batch_receipt_destination",
              "metadata_call_permitted",
              "discovery_permitted",
              "selection_permitted",
              "retries_permitted",
              "redirects_permitted",
              "stop_on_first_failure",
              "preserve_exact_returned_bytes",
              "provenance_review_required",
              "downstream_use_permitted",
              "tts_generation_permitted",
              "voice_mutation_permitted",
              "hume_disclosure_permitted",
              "hume_clone_creation_permitted",
              "rights_and_consent"
            ],
            "properties": {
              "samples": {"minItems": 3, "maxItems": 3},
              "batch_receipt_destination": {"type": "string", "minLength": 1},
              "metadata_call_permitted": {"const": false},
              "discovery_permitted": {"const": false},
              "selection_permitted": {"const": false},
              "retries_permitted": {"const": false},
              "redirects_permitted": {"const": false},
              "stop_on_first_failure": {"const": true},
              "preserve_exact_returned_bytes": {"const": true},
              "provenance_review_required": {"const": true},
              "downstream_use_permitted": {"const": false},
              "tts_generation_permitted": {"const": false},
              "voice_mutation_permitted": {"const": false},
              "hume_disclosure_permitted": {"const": false},
              "hume_clone_creation_permitted": {"const": false},
              "rights_and_consent": {
                "properties": {"provider_disclosure_approved": {"const": true}}
              }
            }
          },
          "requested_limits": {
            "required": [
              "max_metadata_calls",
              "max_sample_download_calls",
              "max_download_bytes",
              "max_spend_usd"
            ],
            "properties": {
              "max_metadata_calls": {"const": 0},
              "max_sample_download_calls": {"const": 3},
              "max_download_bytes": {"const": 20000000},
              "max_spend_usd": {"const": 0}
            }
          },
          "authorized_limits": {
            "required": ["max_calls", "max_downloads", "max_download_bytes", "max_spend_usd"],
            "properties": {
              "max_calls": {"const": 3},
              "max_downloads": {"const": 3},
              "max_download_bytes": {"const": 20000000},
              "max_spend_usd": {"const": 0}
            }
          },
          "consumption": {
            "required": ["status", "calls_used", "downloads_used", "spend_used_usd", "record_path"],
            "properties": {
              "status": {"const": "unconsumed"},
              "calls_used": {"const": 0},
              "downloads_used": {"const": 0},
              "spend_used_usd": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"status": {"const": "active"}}},
          {"properties": {"scope": {"const": "elevenlabs_sample_metadata_inventory"}}},
          {
            "properties": {
              "action": {
                "required": ["kind"],
                "properties": {
                  "kind": {"const": "read_only_voice_metadata_inventory"}
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": ["requested_limits"],
        "properties": {
          "action": {
            "required": [
              "metadata_receipt_destination",
              "selection_permitted",
              "download_permitted",
              "raw_payload_storage_permitted"
            ],
            "properties": {
              "selection_permitted": {"const": false},
              "download_permitted": {"const": false},
              "raw_payload_storage_permitted": {"const": false}
            }
          },
          "requested_limits": {
            "required": [
              "max_metadata_calls",
              "max_sample_download_calls",
              "max_metadata_response_bytes",
              "max_spend_usd"
            ],
            "properties": {
              "max_metadata_calls": {"const": 1},
              "max_sample_download_calls": {"const": 0},
              "max_metadata_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000},
              "max_spend_usd": {"const": 0}
            }
          },
          "authorized_limits": {
            "required": ["max_calls", "max_downloads", "max_metadata_response_bytes", "max_spend_usd"],
            "properties": {
              "max_calls": {"const": 1},
              "max_downloads": {"const": 0},
              "max_metadata_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000},
              "max_spend_usd": {"const": 0}
            }
          },
          "consumption": {
            "required": [
              "status",
              "calls_used",
              "downloads_used",
              "spend_used_usd",
              "record_path"
            ],
            "properties": {
              "status": {"const": "unconsumed"},
              "calls_used": {"const": 0},
              "downloads_used": {"const": 0},
              "spend_used_usd": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"status": {"const": "active"}}},
          {"properties": {"scope": {"const": "hume_clone_creation"}}}
        ]
      },
      "then": {
        "properties": {
          "action": {
            "required": [
              "source_sample_mime_type",
              "source_sample_duration_seconds",
              "rights_and_consent"
            ],
            "properties": {
              "source_sample_sha256": {"$ref": "#/$defs/sha256"},
              "source_sample_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
              "rights_and_consent": {
                "properties": {"provider_disclosure_approved": {"const": true}}
              }
            }
          },
          "account_requirements": {
            "required": [
              "account_tier",
              "commercial_use_eligibility",
              "logged_in_session_is_authorization",
              "commercial_terms_receipt_path",
              "commercial_terms_receipt_sha256"
            ],
            "properties": {"logged_in_session_is_authorization": {"const": false}}
          },
          "authorized_limits": {
            "required": ["max_ui_uploads", "max_voice_clones", "max_spend_usd"]
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"status": {"const": "active"}}},
          {"properties": {"scope": {"const": "hume_calibration"}}}
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "fallback_requires_capability_rejection_receipt": {"const": true},
              "fallback_requires_actual_codec_bitrate_verification": {"const": true}
            }
          },
          "bindings": {
            "required": [
              "script_sha256",
              "spoken_text_sha256",
              "clone_receipt_path",
              "clone_receipt_sha256",
              "compiled_hash_state"
            ],
            "properties": {
              "clone_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "compiled_hash_state": {"const": "final_real_clone_id_bound"}
            }
          },
          "account_requirements": {
            "required": [
              "account_tier",
              "commercial_use_eligibility",
              "logged_in_session_is_authorization",
              "commercial_terms_receipt_path",
              "commercial_terms_receipt_sha256"
            ],
            "properties": {"logged_in_session_is_authorization": {"const": false}}
          },
          "authorized_limits": {
            "required": ["max_calls", "max_outputs", "max_characters", "max_spend_usd"]
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"status": {"const": "active"}}},
          {"properties": {"scope": {"const": "elevenlabs_calibration"}}}
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "fallback_requires_capability_rejection_receipt": {"const": true},
              "fallback_requires_actual_codec_bitrate_verification": {"const": true}
            }
          },
          "bindings": {"required": ["script_sha256", "spoken_text_sha256"]},
          "authorized_limits": {"required": ["max_calls", "max_outputs", "max_characters", "max_spend_usd"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNonnegative": {"type": ["integer", "number", "null"], "minimum": 0},
    "rightsAndConsent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice_owner", "provider_disclosure_approved", "record_path", "record_sha256"],
      "properties": {
        "voice_owner": {"type": "string", "minLength": 1},
        "provider_disclosure_approved": {"type": "boolean"},
        "record_path": {"type": "string", "minLength": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retrievalAction": {
      "type": "object",
      "additionalProperties": false,
