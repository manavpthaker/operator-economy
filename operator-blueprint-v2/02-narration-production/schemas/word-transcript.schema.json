{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoperatoreconomy.com/schemas/oe-word-transcript-v1.json",
  "title": "OE Step 2 master-derived word transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_dir", "spoken_identity", "master", "words", "unresolved_mismatches"],
  "properties": {
    "schema_version": {"const": "oe-word-transcript-v1"},
    "base_dir": {"type": "string", "minLength": 1},
    "spoken_identity": {"$ref": "#/$defs/spokenIdentity"},
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "duration_ms"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "duration_ms": {"type": "integer", "minimum": 1}
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "canonical_token", "start_ms", "end_ms", "review_state"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "canonical_token": {"type": "string", "minLength": 1},
          "w_id": {"type": "string", "pattern": "^w[0-9]{6}$"},
          "display_token": {"type": "string"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_state": {"enum": ["approved", "needs_review"]},
          "alignment_parts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start_ms", "end_ms"],
              "properties": {
                "start_ms": {"type": "integer", "minimum": 0},
                "end_ms": {"type": "integer", "minimum": 1},
                "label": {"type": "string"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "unresolved_mismatches": {
      "oneOf": [
        {"const": 0},
        {"type": "array", "maxItems": 0}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spokenIdentity": {
      "type": "object",
      "required": ["schema_version", "token_count", "sha256"],
      "properties": {
        "schema_version": {"const": "oe-spoken-text-v1"},
        "token_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
