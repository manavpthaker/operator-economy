
# studio working dirs
studio/input/
studio/output/
studio/originate/*/footage_candidates/
studio/originate/*/vo/
studio/remotion/node_modules/
studio/remotion/out/
__pycache__/
.env
.DS_Store

# secrets
.secrets/

# DAW working files (keep local, never in git — >100MB breaks GitHub push)
*.aup4
*.aup4-shm
*.aup4-wal
*.band/
studio/.bedwork/
.vercel
.env*

# episode media — large binaries, regenerable from the pipeline, never in git.
# ep004-final.mp4 alone is 641MB; GitHub hard-fails any file over 100MB.
studio/originate/*/*.mp4
studio/originate/*/avatars/
studio/remotion/public/vo/
studio/remotion/public/thumbs/
studio/remotion/public/footage/
studio/originate/*/footage/
# (site/public/blueprints/*.pdf IS committed — the deployed site serves it)

# python virtualenv (uv-managed, CPython 3.12). Recreate with:
#   uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r studio/requirements.txt
.venv/

# simple-icons metadata cache (fetch_logos.py)
studio/.cache/
